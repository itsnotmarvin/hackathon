# Optional live discovery. The directory and saved research work without keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MONID_BIN=monid

# Optional access protection for externally hosted workspaces.
# Export this variable in the server environment; do not place tokens in browser code.
GARDEN_ACCESS_TOKEN=

# Optional read-only connection to the team's existing founder evidence database.
# Export these variables in the server environment. The adapter performs GETs only.
SUPABASE_URL=
SUPABASE_READONLY_KEY=
# Existing SUPABASE_SERVICE_ROLE_KEY is supported server-side if no read-only key is available.
