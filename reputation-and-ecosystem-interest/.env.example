# Server only. Never put these values in frontend code or commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional explicit executable paths for a hosted environment:
# MONID_BIN=/path/to/monid
# REPUTATION_DB=/persistent/path/reputation.sqlite3
# REPUTATION_ACCESS_TOKEN=replace-with-a-long-random-value-before-remote-hosting
# Local preview binds to 127.0.0.1 by default.
