# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# People Data Labs — founder identity/education/employment enrichment
# https://www.peopledatalabs.com/
PDL_API_KEY=

# OpenCorporates — officer/company history search
# https://api.opencorporates.com/documentation/API-Reference
OPENCORPORATES_API_KEY=

# USPTO TSDR — trademark case status by serial/registration number
# https://developer.uspto.gov/tsdr-api  (search-by-owner is not exposed publicly by USPTO;
# use TESS manually or PatentsView for patents — see services/uspto.py)
USPTO_API_KEY=

# SEC EDGAR full text / submissions search requires a descriptive User-Agent, not a key.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT_EMAIL=

# SBIR.gov awards API and USAspending API are public and require no key.
