# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# People Data Labs — founder identity/education/employment enrichment
# https://www.peopledatalabs.com/
PDL_API_KEY=

# USPTO TSDR — trademark case status by serial/registration number
# https://developer.uspto.gov/tsdr-api  (lookup by known number only; there
# is no public "search trademarks by owner" API — see services/uspto.py)
USPTO_API_KEY=

# SEC EDGAR full text / submissions search requires a descriptive User-Agent, not a key.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT_EMAIL=

# Everything else (Wikidata, Wikipedia, Semantic Scholar, ORCID, GDELT,
# GitHub, NSF Award Search, NIH RePORTER, USAspending, College Scorecard)
# is public and keyless. GitHub and Semantic Scholar accept an optional
# token/key (GITHUB_TOKEN, SEMANTIC_SCHOLAR_API_KEY) to raise rate limits,
# not required to function.
#
# NOTE: OpenCorporates was removed (2026-09-25) — its officer/company-
# history search requires a paid API token with no usable free tier
# (confirmed 401 Unauthorized on every request without one). SBIR.gov
# (403 on all requests), arXiv (406 to every `requests` call from this
# stack), and USPTO's Assignment API (hostname does not resolve) were
# investigated and are documented as non-functional in their respective
# service modules rather than wired in.
